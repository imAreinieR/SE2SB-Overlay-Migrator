<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
	<EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
	<AssemblyName>SE2SB Overlay Migrator</AssemblyName>
    <RootNamespace>StreamElementsToStreamerBotOverlayMigrator</RootNamespace>
	<Product>SE To SB Migration Tool</Product>
	<Company>imACompany</Company>
	<Copyright>Copyright © Ami Reinier 2026</Copyright>
	<Version>0.7.0</Version>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
  	<DebugType>none</DebugType>
  	<DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
  	<PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.11" />
  	<PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  	<PackageReference Include="SourceGear.sqlite3" Version="3.53.4" />
  	<PackageReference Include="SQLitePCLRaw.config.e_sqlite3" Version="3.0.5" />
  	<PackageReference Include="SQLitePCLRaw.core" Version="3.0.5" />
  </ItemGroup>
  <Target Name="CopyUpdater" AfterTargets="Publish">
    <Exec Command="dotnet publish ..\ApplicationUpdater\ApplicationUpdater.csproj -c Release -o $(PublishDir) --nologo -v quiet" />
  </Target>
  <Target Name="RemoveWebView2XmlFiles" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="$([System.String]::Copy('%(Filename)').StartsWith('Microsoft.Web.WebView2')) and '%(Extension)' == '.xml'" />
    </ItemGroup>
  </Target>
  <Target Name="ZipPublishOutput" AfterTargets="Publish">
    <PropertyGroup>
      <ZipName>$(AssemblyName)-v$(Version)</ZipName>
      <ZipTempPath>$(MSBuildProjectDirectory)\bin\Release\$(ZipName).zip</ZipTempPath>
      <ZipFinalPath>$(PublishDir)$(ZipName).zip</ZipFinalPath>
    </PropertyGroup>
    <Delete Files="$(ZipTempPath);$(ZipFinalPath);$(PublishDir)$(ZipName).zip.sha256" />
    <ZipDirectory SourceDirectory="$(PublishDir)" DestinationFile="$(ZipTempPath)" Overwrite="true" />
    <Move SourceFiles="$(ZipTempPath)" DestinationFiles="$(ZipFinalPath)" />
  </Target>
  <Target Name="GenerateZipChecksum" AfterTargets="ZipPublishOutput">
    <Exec Command="powershell -Command &quot;$h = Get-FileHash '$(PublishDir)$(ZipName).zip' -Algorithm SHA256; $h.Hash.ToLower() + '  $(ZipName).zip' | Out-File -Encoding utf8 '$(PublishDir)$(ZipName).zip.sha256'&quot;" />
  </Target>
</Project>