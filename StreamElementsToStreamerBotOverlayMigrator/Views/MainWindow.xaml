<Window x:Class="StreamElementsToStreamerBotOverlayMigrator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:StreamElementsToStreamerBotOverlayMigrator.Behaviors"
        Title="SE Overlay Migration Tool"
        Width="820" Height="547"
        MinWidth="720" MinHeight="480"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBgBrush}">

    <Window.Resources>

        <!-- ── Button base ── -->
        <Style x:Key="BaseBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.65"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SaveBtn" TargetType="Button" BasedOn="{StaticResource BaseBtn}">
            <Setter Property="Background" Value="{StaticResource AccentBlueBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="14,6"/>
        </Style>

        <Style x:Key="ImportBtn" TargetType="Button" BasedOn="{StaticResource BaseBtn}">
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,6"/>
        </Style>

        <Style x:Key="SmallImportBtn" TargetType="Button" BasedOn="{StaticResource BaseBtn}">
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style x:Key="UndoBtn" TargetType="Button" BasedOn="{StaticResource BaseBtn}">
            <Setter Property="Background" Value="{StaticResource SidebarBgBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderHoverBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,0"/>
        </Style>

        <Style x:Key="GenerateBtn" TargetType="Button" BasedOn="{StaticResource BaseBtn}">
            <Setter Property="Background" Value="{StaticResource AccentGreenBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentGreenFgBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="22,9"/>
        </Style>

        <Style x:Key="CopyBtn" TargetType="Button" BasedOn="{StaticResource BaseBtn}">
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="NewWidgetBtn" TargetType="Button" BasedOn="{StaticResource BaseBtn}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderAccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0,7"/>
        </Style>

        <!-- Small square icon button (e.g. edit-mode toggle) -->
        <Style x:Key="SquareIconBtn" TargetType="Button" BasedOn="{StaticResource BaseBtn}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderAccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <!-- Remove X button — transparent, shown via trigger on parent -->
        <Style x:Key="RemoveWidgetBtn" TargetType="Button" BasedOn="{StaticResource BaseBtn}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource DangerAltBrush}"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- File remove X -->
        <Style x:Key="FileRemoveBtn" TargetType="Button" BasedOn="{StaticResource BaseBtn}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource DangerAltBrush}"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- Read-only path TextBox -->
        <Style x:Key="PathBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="PathBoxBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="10,0"
                                          VerticalAlignment="Center"
                                          VerticalScrollBarVisibility="Hidden"
                                          HorizontalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PathBoxBorder" Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}"/>
                                <Setter Property="TextDecorations" Value="Underline"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Editable name TextBox -->
        <Style x:Key="NameBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBlueBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="10,0"
                                          VerticalAlignment="Center"
                                          VerticalScrollBarVisibility="Hidden"
                                          HorizontalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Inline widget name edit TextBox -->
        <Style x:Key="InlineNameBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBlueBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="4,0"
                                          VerticalAlignment="Center"
                                          VerticalScrollBarVisibility="Hidden"
                                          HorizontalScrollBarVisibility="Hidden"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Section label -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Small square "more options" button -->
        <Style x:Key="MoreOptionsBtn" TargetType="Button" BasedOn="{StaticResource BaseBtn}">
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- Dark dropdown menu item, used in the "more options" dropdown -->
        <Style x:Key="DropdownMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="ItemBorder"
                                Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark dropdown menu popup, used for the "more options" button -->
        <Style x:Key="DropdownMenu" TargetType="ContextMenu">
            <Setter Property="Placement" Value="Bottom"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="4"
                                SnapsToDevicePixels="True">
                            <ItemsPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ══════════════════════════════════════════
         Two-panel layout: sidebar | detail
    ═══════════════════════════════════════════════ -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── LEFT SIDEBAR ── -->
        <Border Grid.Column="0" Grid.Row="0"
                Background="{StaticResource SidebarBgBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Header -->
                    <RowDefinition Height="*"/>     <!-- Widget list -->
                    <RowDefinition Height="Auto"/>  <!-- Legend -->
                </Grid.RowDefinitions>

                <!-- Sidebar header -->
                <Border Grid.Row="0"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="14,14,14,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="WIDGETS"
                                       Style="{StaticResource SectionLabel}"
                                       Margin="0"
                                       VerticalAlignment="Center"/>

                            <Button x:Name="SettingsBtn"
                                    Grid.Column="1"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="4,0"
                                    Cursor="Hand"
                                    VerticalAlignment="Center"
                                    ToolTip="Settings"
                                    Click="Settings_Click">
                                <TextBlock Text="⚙"
                                           Style="{StaticResource SectionLabel}"
                                           FontSize="14"
                                           Margin="0"/>
                            </Button>

                            <Button x:Name="VersionLabel"
                                    Grid.Column="2"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0"
                                    Cursor="Hand"
                                    VerticalAlignment="Center"
                                    ToolTip="Check for updates"
                                    Click="VersionLabel_Click">
                                <TextBlock Text="v0.1.0"
                                           Style="{StaticResource SectionLabel}"
                                           Margin="0"/>
                            </Button>
                        </Grid>

                        <!-- New Widget + edit-mode toggle row -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Style="{StaticResource NewWidgetBtn}"
                                    Click="NewWidget_Click">
                                <TextBlock Text="＋  New Widget"
                                           FontFamily="Segoe UI"
                                           FontSize="12"/>
                            </Button>

                            <!-- Reorder / edit-mode toggle -->
                            <Button x:Name="EditModeToggleBtn"
                                    Grid.Column="1"
                                    Style="{StaticResource SquareIconBtn}"
                                    Margin="8,0,0,0"
                                    ToolTip="Reorder widgets"
                                    Click="EditModeToggle_Click">
                                <TextBlock x:Name="EditModeToggleIcon"
                                           Text="&#10303;"
                                           Foreground="{StaticResource AccentBlueBrush}"
                                           FontFamily="Segoe UI Symbol"
                                           FontSize="14"/>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Widget list -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              Padding="8,8">
                    <ListBox x:Name="WidgetList"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             behaviors:ScrollPassthrough.IsEnabled="True"
                             AllowDrop="True"
                             SelectionChanged="WidgetList_SelectionChanged"
                             DragLeave="WidgetList_DragLeave">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="RowBorder"
                                                    Background="Transparent"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="1"
                                                    CornerRadius="5">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="RowBorder" Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="RowBorder" Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                                                    <Setter TargetName="RowBorder" Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid x:Name="WidgetRow"
                                      Margin="0,2"
                                      AllowDrop="True"
                                      DragOver="WidgetRow_DragOver"
                                      Drop="WidgetRow_Drop">

                                    <Border x:Name="ItemBorder"
                                            Padding="10,9"
                                            Background="Transparent"
                                            Cursor="Hand">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>  <!-- Drag handle -->
                                                <ColumnDefinition Width="Auto"/>  <!-- Status dot -->
                                                <ColumnDefinition Width="*"/>     <!-- Name -->
                                                <ColumnDefinition Width="Auto"/>  <!-- Edit icon -->
                                                <ColumnDefinition Width="Auto"/>  <!-- X -->
                                            </Grid.ColumnDefinitions>

                                            <!-- Drag handle (edit mode only) -->
                                            <TextBlock x:Name="DragHandle"
                                                       Grid.Column="0"
                                                       Text="⠿"
                                                       FontSize="13"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0"
                                                       Cursor="SizeAll"
                                                       Visibility="Collapsed"
                                                       MouseLeftButtonDown="DragHandle_MouseLeftButtonDown"
                                                       MouseMove="DragHandle_MouseMove"/>

                                            <!-- Status dot -->
                                            <Ellipse x:Name="WidgetStatusDot"
                                                     Grid.Column="1"
                                                     Width="6" Height="6"
                                                     Margin="0,0,8,0"
                                                     VerticalAlignment="Center"
                                                     Fill="{Binding StatusColor}" />

                                            <!-- Widget name display + edit toggle -->
                                            <Grid Grid.Column="2">
                                                <!-- Display mode -->
                                                <StackPanel x:Name="NameDisplayPanel"
                                                            Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontFamily="Segoe UI"
                                                               FontSize="12"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxWidth="100"/>
                                                </StackPanel>

                                                <!-- Edit mode -->
                                                <TextBox x:Name="NameEditBox"
                                                         Style="{StaticResource InlineNameBox}"
                                                         Visibility="Collapsed"
                                                         Height="24"
                                                         KeyDown="WidgetNameBox_KeyDown"
                                                         LostFocus="WidgetNameBox_LostFocus"/>
                                            </Grid>

                                            <!-- Edit icon (hidden, shown on row hover) -->
                                            <TextBlock x:Name="EditIcon"
                                                       Grid.Column="3"
                                                       Text="✎"
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,2,0"
                                                       Opacity="0"
                                                       Cursor="Hand"
                                                       ToolTip="Rename widget"
                                                       MouseLeftButtonUp="EditWidgetName_MouseUp"/>

                                            <!-- Remove X (hidden, shown on row hover) -->
                                            <Button Grid.Column="4"
                                                    x:Name="RemoveBtn"
                                                    Content="✕"
                                                    Tag="{Binding}"
                                                    Style="{StaticResource RemoveWidgetBtn}"
                                                    ToolTip="Delete widget"
                                                    Click="RemoveWidget_Click"/>
                                        </Grid>
                                    </Border>

                                    <!-- Drop position indicator — shown above/below this row while dragging -->
                                    <Border x:Name="DropIndicatorTop"
                                            Height="2"
                                            Margin="10,-2,10,0"
                                            VerticalAlignment="Top"
                                            Background="{StaticResource AccentBlueBrush}"
                                            CornerRadius="1"
                                            IsHitTestVisible="False"
                                            Visibility="Collapsed"/>
                                    <Border x:Name="DropIndicatorBottom"
                                            Height="2"
                                            Margin="10,0,10,-2"
                                            VerticalAlignment="Bottom"
                                            Background="{StaticResource AccentBlueBrush}"
                                            CornerRadius="1"
                                            IsHitTestVisible="False"
                                            Visibility="Collapsed"/>

                                    <!-- Hover/active triggers -->
                                    <Grid.Triggers>
                                        <EventTrigger RoutedEvent="MouseEnter">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="RemoveBtn"
                                                                     Storyboard.TargetProperty="Opacity"
                                                                     To="0.6" Duration="0:0:0.15"/>
                                                    <DoubleAnimation Storyboard.TargetName="EditIcon"
                                                                     Storyboard.TargetProperty="Opacity"
                                                                     To="0.6" Duration="0:0:0.15"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                        <EventTrigger RoutedEvent="MouseLeave">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="RemoveBtn"
                                                                     Storyboard.TargetProperty="Opacity"
                                                                     To="0" Duration="0:0:0.15"/>
                                                    <DoubleAnimation Storyboard.TargetName="EditIcon"
                                                                     Storyboard.TargetProperty="Opacity"
                                                                     To="0" Duration="0:0:0.15"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Grid.Triggers>
                                </Grid>

                                <!-- Swap rename/remove for the drag handle while in edit mode -->
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter TargetName="DragHandle" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="EditIcon" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="RemoveBtn" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>

                <!-- Status legend -->
                <Border Grid.Row="2"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="14,10">
                    <StackPanel Orientation="Horizontal">

                        <Ellipse Width="7" Height="7"
                                 Fill="{StaticResource AccentGreenBrush}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,6,0"/>
                        <TextBlock Text="Ready"
                                   FontFamily="Segoe UI"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,14,0"/>

                        <Ellipse Width="7" Height="7"
                                 Fill="{StaticResource WarningIconBrush}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,6,0"/>
                        <TextBlock Text="Modified"
                                   FontFamily="Segoe UI"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,14,0"/>

                        <Ellipse Width="7" Height="7"
                                 Fill="{StaticResource DangerBrush}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,6,0"/>
                        <TextBlock Text="Missing Files"
                                   FontFamily="Segoe UI"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"/>

                    </StackPanel>
                </Border>

            </Grid>
        </Border>

        <!-- ── RIGHT DETAIL PANEL ── -->
        <Grid Grid.Column="1" Background="{StaticResource PanelBgBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>     <!-- Detail content / empty state -->
                <RowDefinition Height="Auto"/>  <!-- Detail footer -->
            </Grid.RowDefinitions>

            <!-- Empty state: only shown when no widgets exist -->
            <Grid Grid.Row="0" x:Name="EmptyStatePanel" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="📦"
                               FontSize="36"
                               HorizontalAlignment="Center"
                               Opacity="0.2"
                               Margin="0,0,0,12"/>
                    <TextBlock Text="No widgets yet."
                               Foreground="{StaticResource TextDimBrush}"
                               FontFamily="Segoe UI"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,14"/>
                    <Button Style="{StaticResource NewWidgetBtn}"
                            Padding="20,10"
                            Click="NewWidget_Click">
                        <TextBlock Text="＋  Create a widget to get started"
                                   FontFamily="Segoe UI"
                                   FontSize="13"/>
                    </Button>
                </StackPanel>
            </Grid>



            <!-- Detail content -->
            <ScrollViewer Grid.Row="0" x:Name="DetailContentPanel"
                          VerticalScrollBarVisibility="Auto"
                          Padding="20,16,30,16">
                <StackPanel>

                    <!-- Warning banner -->
                    <Border x:Name="WarningBanner"
                            Background="{StaticResource WarningBgBrush}"
                            BorderBrush="{StaticResource WarningBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="12,8"
                            Margin="0,0,0,14"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠  "
                                       Foreground="{StaticResource WarningIconBrush}"
                                       FontSize="12"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="WarningText"
                                       Foreground="{StaticResource WarningTextBrush}"
                                       FontFamily="Segoe UI"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Files section -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="FILES"
                                   Style="{StaticResource SectionLabel}"
                                   Margin="0"
                                   VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource SmallImportBtn}"
                                    Height="22"
                                    ToolTip="Import widget files"
                                    Click="Import_Click">
                                ＋ Import
                            </Button>
                            <Button x:Name="ImportMoreBtn"
                                    Style="{StaticResource MoreOptionsBtn}"
                                    Margin="4,0,0,0"
                                    ToolTip="More file options"
                                    IsEnabled="False"
                                    Click="ImportMore_Click">
                                <TextBlock Text="⋯" FontSize="14"/>
                                <Button.ContextMenu>
                                    <ContextMenu Style="{StaticResource DropdownMenu}">
                                        <MenuItem Header="Duplicate as New"
                                                  Style="{StaticResource DropdownMenuItem}"
                                                  Click="DuplicateWidget_Click"/>
                                        <MenuItem Header="Export Raw Files"
                                                  Style="{StaticResource DropdownMenuItem}"
                                                  Click="ExportRawFiles_Click"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- File list -->
                        <Border x:Name="FileListBorder"
                                Grid.Column="0"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="5"
                                MinHeight="40">
                            <StackPanel>
                                <ItemsControl x:Name="FileList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Border BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="0,0,0,1"
                                                        Padding="10,7">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Extension badge -->
                                                        <Grid Grid.Column="0"
                                                              Width="80">
                                                            <Border Background="{Binding WidgetFileTypeColor}"
                                                                    CornerRadius="3"
                                                                    Padding="5,2"
                                                                    Margin="0,0,8,0"
                                                                    HorizontalAlignment="Left"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding WidgetFileType}"
                                                                           Foreground="Black"
                                                                           FontFamily="Consolas"
                                                                           FontSize="10"/>
                                                            </Border>
                                                        </Grid>

                                                        <!-- Filename -->
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding FileName}"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                   FontFamily="Consolas"
                                                                   FontSize="11"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"/>

                                                        <!-- Remove X (hidden until row hover) -->
                                                        <Button Grid.Column="2"
                                                                x:Name="FileRemoveBtn"
                                                                Content="✕"
                                                                Tag="{Binding}"
                                                                Style="{StaticResource FileRemoveBtn}"
                                                                ToolTip="Remove file"
                                                                Click="RemoveFile_Click"/>
                                                    </Grid>
                                                </Border>

                                                <!-- Hover triggers for X fade -->
                                                <Grid.Triggers>
                                                    <EventTrigger RoutedEvent="MouseEnter">
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="FileRemoveBtn"
                                                                                 Storyboard.TargetProperty="Opacity"
                                                                                 To="0.6" Duration="0:0:0.15"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                    <EventTrigger RoutedEvent="MouseLeave">
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="FileRemoveBtn"
                                                                                 Storyboard.TargetProperty="Opacity"
                                                                                 To="0" Duration="0:0:0.15"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </Grid.Triggers>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Empty state / drop zone (hidden once files are present) -->
                                <Grid x:Name="FilesEmptyLabel"
                                      AllowDrop="True"
                                      Margin="8,8"
                                      DragOver="DropZone_DragOver"
                                      DragLeave="DropZone_DragLeave"
                                      Drop="DropZone_Drop">
                                    <!-- Dashed border drawn as a Rectangle -->
                                    <Rectangle x:Name="DropZoneDash"
                                               Stroke="{StaticResource DropZoneBorderBrush}"
                                               StrokeThickness="1.5"
                                               StrokeDashArray="4 3"
                                               RadiusX="4" RadiusY="4"
                                               Fill="Transparent"/>
                                    <StackPanel HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Margin="0,18">
                                        <TextBlock x:Name="DropZoneIcon"
                                                   Text="⬆"
                                                   FontSize="20"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Margin="0,0,0,6"/>
                                        <TextBlock x:Name="DropZoneText"
                                                   Text="Drop files here"
                                                   Foreground="{StaticResource TextDropZoneBrush}"
                                                   FontFamily="Segoe UI"
                                                   FontSize="12"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,2"/>
                                        <TextBlock Text="or use ＋ Import above"
                                                   Foreground="{StaticResource TextSubtleBrush}"
                                                   FontFamily="Segoe UI"
                                                   FontSize="10"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="Supports .html, .js, .css, .json, .zip"
                                                   Foreground="{StaticResource TextSubtleBrush}"
                                                   FontFamily="Segoe UI"
                                                   FontSize="10"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                    </Grid>

                    <!-- Folder path section -->
                    <TextBlock Text="FOLDER LOCATION" Style="{StaticResource SectionLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 x:Name="FolderPathBox"
                                 Style="{StaticResource PathBox}"
                                 Height="34"
                                 Cursor="Hand"
                                 ToolTip="Click to open folder in File Explorer"
                                 PreviewMouseLeftButtonDown="FolderPathBox_Click"/>

                        <Button x:Name="CopyPathBtn"
                                Grid.Column="2"
                                Style="{StaticResource CopyBtn}"
                                Height="34"
                                Margin="0,0,10,0"
                                ToolTip="Copy path to clipboard"
                                Click="CopyPath_Click">
                            <TextBlock Text="⧉" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Button>
                    </Grid>

                    <!-- Configuration section -->
                    <TextBlock Text="CONFIGURATION" Style="{StaticResource SectionLabel}" Margin="0,12,0,6"/>
                    <Button x:Name="ConfigureBtn"
                            Style="{StaticResource ImportBtn}"
                            Height="34"
                            HorizontalAlignment="Left"
                            IsEnabled="False"
                            Click="Configure_Click"
                            ToolTip="Adjust widget settings and test live events">
                        ⚙  Configure &amp; Test
                    </Button>

                    <!-- Widget name / author, parsed from data.json. Hidden when neither is available. -->
                    <StackPanel x:Name="WidgetInfoPanel"
                                HorizontalAlignment="Right"
                                Margin="0,10,0,0"
                                Visibility="Collapsed"
                                ToolTip="From data.json">
                        <TextBlock x:Name="WidgetNameText"
                                   FontFamily="Segoe UI"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   HorizontalAlignment="Right"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="WidgetAuthorText"
                                   FontFamily="Segoe UI"
                                   FontSize="10"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Right"
                                   Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="Collapsed"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- Detail footer: status + generate -->
            <Border Grid.Row="1"
                    Background="{StaticResource AppBgBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="20,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="StatusText"
                               Grid.Column="0"
                               Foreground="{StaticResource TextDimBrush}"
                               FontFamily="Consolas"
                               FontSize="11"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Text="Select or create a widget to begin."/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="UndoBtn"
                                Style="{StaticResource UndoBtn}"
                                Height="38"
                                Margin="0,0,8,0"
                                IsEnabled="False"
                                Click="UndoWidget_Click">
                            Undo
                        </Button>
                        <Button x:Name="GenerateBtn"
                                Style="{StaticResource GenerateBtn}"
                                Height="38"
                                IsEnabled="False"
                                Click="SaveAndGenerate_Click">
                            Save &amp; Generate
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</Window>

