<Window x:Class="StreamElementsToStreamerBotOverlayMigrator.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:StreamElementsToStreamerBotOverlayMigrator.Controls"
        Title="Settings"
        Width="675" Height="450"
        MinWidth="570" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBgBrush}"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>

        <!-- Vertical side-tab button (copied from WidgetConfigWindow for visual consistency) -->
        <Style x:Key="VerticalTabBtn" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <!-- Active left-edge bar -->
                            <Border x:Name="ActiveBar"
                                    Width="2"
                                    Background="{StaticResource AccentBlueBrush}"
                                    HorizontalAlignment="Left"
                                    Visibility="Collapsed"/>
                            <!-- Background highlight -->
                            <Border x:Name="Bg"
                                    Background="Transparent"
                                    Margin="2,0,0,0">
                                <!-- Rotated label, fixed size (no Viewbox scaling) -->
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                <Setter TargetName="ActiveBar" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource SurfaceBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextHoverBrush}"/>
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Field label (copied from WidgetConfigWindow) -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextFieldLabelBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Field hint / description text below a field -->
        <Style x:Key="FieldHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <!-- Text input (copied from WidgetConfigWindow) -->
        <Style x:Key="FieldInput" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource SurfaceDeepBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBlueBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          VerticalScrollBarVisibility="Hidden"
                                          HorizontalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Password input, mirrors FieldInput (no PasswordBox equivalent exists yet) -->
        <Style x:Key="FieldPasswordInput" TargetType="PasswordBox">
            <Setter Property="Background" Value="{StaticResource SurfaceDeepBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBlueBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          VerticalScrollBarVisibility="Hidden"
                                          HorizontalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary button, used for Cancel (copied from WidgetConfigWindow's FieldButton) -->
        <Style x:Key="FieldButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small inline "reset to default" button, overlaid inside a TextBox -->
        <Style x:Key="FieldClearButton" TargetType="Button">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="Reset to default"/>
            <Setter Property="Content" Value="&#x2715;"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small inline text toggle button, overlaid inside a field (e.g. Show/Hide password) -->
        <Style x:Key="FieldToggleTextButton" TargetType="Button">
            <Setter Property="Height" Value="20"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small inline "show/hide password" toggle, overlaid inside the password field -->
        <Style x:Key="FieldRevealButton" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Content" Value="Show"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Footer apply button (copied from WidgetConfigWindow) -->
        <Style x:Key="ApplyBtn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentGreenBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentGreenFgBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="24,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Row wrapper matching the Config/Settings tab field rows -->
        <Style x:Key="FieldRow" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="14,10"/>
        </Style>

        <!-- Shared error color for field-level validation.
             Sourced from the active theme's DangerColor (not hardcoded) so it
             follows Dark/Light and Color Blind Mode like everything else. -->
        <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource DangerColor}"/>

    </Window.Resources>

    <!-- Root: vertical tab rail | content -->
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Vertical tab rail -->
            <ColumnDefinition Width="40"/>
            <!-- Thin divider -->
            <ColumnDefinition Width="1"/>
            <!-- Content area -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── Vertical tab rail ── -->
        <Border Grid.Column="0"
                Background="{StaticResource SidebarBgBrush}">
            <StackPanel Orientation="Vertical" Margin="0,8,0,0">

                <ToggleButton x:Name="LeftTabGeneral"
                              Style="{StaticResource VerticalTabBtn}"
                              IsChecked="True"
                              Height="100"
                              Checked="LeftTabGeneral_Checked"
                              ToolTip="General">
                    <TextBlock Text="General"
                               FontFamily="Segoe UI"
                               FontSize="10"
                               TextAlignment="Center"
                               TextWrapping="Wrap">
                        <TextBlock.LayoutTransform>
                            <RotateTransform Angle="-90"/>
                        </TextBlock.LayoutTransform>
                    </TextBlock>
                </ToggleButton>

                <ToggleButton x:Name="LeftTabStreamerBot"
                              Style="{StaticResource VerticalTabBtn}"
                              IsChecked="False"
                              Height="100"
                              Checked="LeftTabStreamerBot_Checked"
                              ToolTip="StreamerBot">
                    <TextBlock Text="StreamerBot"
                               FontFamily="Segoe UI"
                               FontSize="10"
                               TextAlignment="Center"
                               TextWrapping="Wrap">
                        <TextBlock.LayoutTransform>
                            <RotateTransform Angle="-90"/>
                        </TextBlock.LayoutTransform>
                    </TextBlock>
                </ToggleButton>

            </StackPanel>
        </Border>

        <!-- Vertical divider between rail and content -->
        <Border Grid.Column="1" Background="{StaticResource BorderBrush}"/>

        <!-- ── Content area (both tab panels stacked, only one visible) ── -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">

                <!-- ── Tab: General ── -->
                <ScrollViewer x:Name="GeneralPanel"
                              Visibility="Visible"
                              VerticalScrollBarVisibility="Auto"
                              Padding="0,8,0,8">
                    <StackPanel>
                        <Border Style="{StaticResource FieldRow}">
                            <StackPanel>
                                <TextBlock Text="Theme" Style="{StaticResource FieldLabel}"/>
                                <controls:StyledDropdown x:Name="ThemeCombo"
                                                          HorizontalAlignment="Left"
                                                          Width="220"
                                                          SelectionChanged="ThemeCombo_SelectionChanged">
                                    <ComboBoxItem Content="Dark"/>
                                    <ComboBoxItem Content="Light"/>
                                </controls:StyledDropdown>
                                <TextBlock Text="Changing this restarts the window to apply the new theme."
                                           Style="{StaticResource FieldHint}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource FieldRow}" BorderThickness="0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="Color Blind Mode"
                                               Style="{StaticResource FieldLabel}"
                                               Margin="0"
                                               VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1"
                                              x:Name="ColorBlindToggle"
                                              Style="{StaticResource FieldToggle}"
                                              VerticalAlignment="Center"
                                              Checked="ColorBlindToggle_Changed"
                                              Unchecked="ColorBlindToggle_Changed"/>
                                </Grid>
                                <TextBlock Text="Swaps the red/yellow/green status colors for a rose/gold/teal palette that's easier to tell apart with color blindness. Changing this restarts the window to apply the new theme."
                                           Style="{StaticResource FieldHint}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ── Tab: StreamerBot ── -->
                <ScrollViewer x:Name="StreamerBotPanel"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto"
                              Padding="0,8,0,8">
                    <StackPanel>

                        <Border Style="{StaticResource FieldRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="195"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Host" Style="{StaticResource FieldLabel}"/>
                                    <Grid>
                                        <TextBox x:Name="HostBox"
                                                 Style="{StaticResource FieldInput}"
                                                 Padding="8,0,26,0"
                                                 Text="127.0.0.1"/>
                                        <Button Style="{StaticResource FieldClearButton}"
                                                Click="HostClear_Click"/>
                                    </Grid>
                                    <TextBlock x:Name="HostErrorText"
                                               Style="{StaticResource FieldHint}"
                                               Foreground="{StaticResource ErrorBrush}"
                                               Visibility="Collapsed"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Port" Style="{StaticResource FieldLabel}"/>
                                    <Grid>
                                        <TextBox x:Name="PortBox"
                                                 Style="{StaticResource FieldInput}"
                                                 Padding="8,0,26,0"
                                                 Text="8080"/>
                                        <Button Style="{StaticResource FieldClearButton}"
                                                Click="PortClear_Click"/>
                                    </Grid>
                                    <TextBlock x:Name="PortErrorText"
                                               Style="{StaticResource FieldHint}"
                                               Foreground="{StaticResource ErrorBrush}"
                                               Visibility="Collapsed"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource FieldRow}">
                            <StackPanel>
                                <TextBlock Text="Endpoint" Style="{StaticResource FieldLabel}"/>
                                <Grid>
                                    <TextBox x:Name="EndpointBox"
                                             Style="{StaticResource FieldInput}"
                                             Padding="8,0,26,0"
                                             Text="/"/>
                                    <Button Style="{StaticResource FieldClearButton}"
                                            Click="EndpointClear_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource FieldRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="200"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="Enable Authentication"
                                                   Style="{StaticResource FieldLabel}"
                                                   Margin="0"
                                                   VerticalAlignment="Center"/>
                                        <CheckBox Grid.Column="1"
                                                  x:Name="EnableAuthToggle"
                                                  Style="{StaticResource FieldToggle}"
                                                  VerticalAlignment="Center"
                                                  Checked="EnableAuthToggle_Changed"
                                                  Unchecked="EnableAuthToggle_Changed"/>
                                    </Grid>
                                    <TextBlock Text="Only needed if authentication is enabled on the StreamerBot WebSocket server."
                                               Style="{StaticResource FieldHint}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Password" Style="{StaticResource FieldLabel}"/>
                                    <Grid>
                                        <PasswordBox x:Name="PasswordBox"
                                                     Style="{StaticResource FieldPasswordInput}"
                                                     Padding="8,0,44,0"/>
                                        <TextBox x:Name="PasswordRevealBox"
                                                 Style="{StaticResource FieldInput}"
                                                 Padding="8,0,44,0"
                                                 Visibility="Collapsed"/>
                                        <Button x:Name="PasswordVisibilityToggleBtn"
                                                Style="{StaticResource FieldRevealButton}"
                                                Click="PasswordVisibilityToggle_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource FieldRow}" BorderThickness="0">
                            <StackPanel>
                                <TextBlock Text="Connection Test" Style="{StaticResource FieldLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            x:Name="TestConnectionBtn"
                                            Style="{StaticResource FieldButton}"
                                            Click="TestConnection_Click">
                                        Test Connection
                                    </Button>
                                    <TextBlock Grid.Column="1"
                                               x:Name="TestConnectionResultText"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               FontFamily="Consolas"
                                               FontSize="11"
                                               Foreground="{StaticResource TextDimBrush}"
                                               TextWrapping="Wrap"/>
                                </Grid>
                                <TextBlock Text="Connects using the values above and calls GetInfo to confirm it's StreamerBot. This does not save your settings."
                                           Style="{StaticResource FieldHint}"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

            </Grid>

            <!-- Footer: status + cancel/save -->
            <Border Grid.Row="1"
                    Background="{StaticResource SidebarBgBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="20,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="RevertDefaultBtn"
                            Grid.Column="0"
                            Style="{StaticResource FieldButton}"
                            Height="38"
                            Margin="0,0,12,0"
                            Click="RevertToDefault_Click">
                        Revert to Default
                    </Button>

                    <TextBlock x:Name="StatusText"
                               Grid.Column="1"
                               Foreground="{StaticResource TextDimBrush}"
                               FontFamily="Consolas"
                               FontSize="11"
                               VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="CancelBtn"
                                Style="{StaticResource FieldButton}"
                                Height="38"
                                Margin="0,0,8,0"
                                Click="Cancel_Click">
                            Cancel
                        </Button>
                        <Button x:Name="ApplyBtn"
                                Style="{StaticResource ApplyBtn}"
                                Click="Apply_Click">
                            Apply
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</Window>
