<Window x:Class="StreamElementsToStreamerBotOverlayMigrator.WidgetConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Widget Configuration"
        Width="1005" Height="670"
        MinWidth="700" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBgBrush}"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>

        <!-- Group header toggle button -->
        <Style x:Key="GroupHeaderBtn" TargetType="ToggleButton">
            <Setter Property="Background" Value="{StaticResource PanelBgBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="Chevron"
                                           Grid.Column="1"
                                           Text="▾"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chevron" Property="Text" Value="▸"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Field label -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextFieldLabelBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Text / Number input -->
        <Style x:Key="FieldInput" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource SurfaceDeepBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBlueBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="8,0"
                                          VerticalAlignment="Center"
                                          VerticalScrollBarVisibility="Hidden"
                                          HorizontalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Text input with left icon gutter (search box) -->
        <Style x:Key="SearchFieldInput" TargetType="TextBox" BasedOn="{StaticResource FieldInput}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="28,0,8,0"
                                          VerticalAlignment="Center"
                                          VerticalScrollBarVisibility="Hidden"
                                          HorizontalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Field button -->
        <Style x:Key="FieldButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Color swatch button -->
        <Style x:Key="ColorSwatchBtn" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Expand/collapse-all toolbar button -->
        <Style x:Key="ExpandCollapseAllBtn" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Footer save button -->
        <Style x:Key="SaveBtn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentGreenBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentGreenFgBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="24,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Footer undo button -->
        <Style x:Key="UndoBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Preview/Logs tab button -->
        <Style x:Key="PreviewTabBtn" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Bg"
                                    Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <!-- Active indicator bar -->
                            <Border x:Name="ActiveBar"
                                    Height="2"
                                    Background="{StaticResource AccentBlueBrush}"
                                    VerticalAlignment="Bottom"
                                    Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                <Setter TargetName="ActiveBar" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Vertical side-tab button -->
        <Style x:Key="VerticalTabBtn" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <!-- Active left-edge bar -->
                            <Border x:Name="ActiveBar"
                                    Width="2"
                                    Background="{StaticResource AccentBlueBrush}"
                                    HorizontalAlignment="Left"
                                    Visibility="Collapsed"/>
                            <!-- Background highlight -->
                            <Border x:Name="Bg"
                                    Background="Transparent"
                                    Margin="2,0,0,0">
                                <!-- Rotated label, fixed size (no Viewbox scaling) -->
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                <Setter TargetName="ActiveBar" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource SurfaceBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextHoverBrush}"/>
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- Root: left panel | right panel -->
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Left: fixed-width config panel -->
            <ColumnDefinition Width="320" MinWidth="240"/>
            <!-- Splitter -->
            <ColumnDefinition Width="Auto"/>
            <!-- Right: preview/logs panel -->
            <ColumnDefinition Width="*" MinWidth="240"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════════════════════════════════════════
             LEFT PANEL — vertical tab rail + content panels
             ═══════════════════════════════════════════════ -->
        <Grid Grid.Column="0">
            <Grid.ColumnDefinitions>
                <!-- Vertical tab rail -->
                <ColumnDefinition Width="40"/>
                <!-- Thin divider -->
                <ColumnDefinition Width="1"/>
                <!-- Content area -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── Vertical tab rail ── -->
            <Border Grid.Column="0"
                    Background="{StaticResource SidebarBgBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,0">
                <StackPanel Orientation="Vertical"
                            Margin="0,8,0,0">

                    <ToggleButton x:Name="LeftTabConfig"
                                  Style="{StaticResource VerticalTabBtn}"
                                  IsChecked="True"
                                  Height="80"
                                  Checked="LeftTabConfig_Checked"
                                  ToolTip="Widget Configuration">
                        <TextBlock Text="Config"
                                   FontFamily="Segoe UI"
                                   FontSize="14"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap">
                            <TextBlock.LayoutTransform>
                                <RotateTransform Angle="-90"/>
                            </TextBlock.LayoutTransform>
                        </TextBlock>
                    </ToggleButton>

                    <ToggleButton x:Name="LeftTabSimulate"
                                  Style="{StaticResource VerticalTabBtn}"
                                  IsChecked="False"
                                  Height="80"
                                  Checked="LeftTabSimulate_Checked"
                                  ToolTip="Simulate Events">
                        <TextBlock Text="Simulate"
                                   FontFamily="Segoe UI"
                                   FontSize="14"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap">
                            <TextBlock.LayoutTransform>
                                <RotateTransform Angle="-90"/>
                            </TextBlock.LayoutTransform>
                        </TextBlock>
                    </ToggleButton>

                    <ToggleButton x:Name="LeftTabSettings"
                                  Style="{StaticResource VerticalTabBtn}"
                                  IsChecked="False"
                                  Height="80"
                                  Checked="LeftTabSettings_Checked"
                                  ToolTip="Settings">
                        <TextBlock Text="Settings"
                                   FontFamily="Segoe UI"
                                   FontSize="14"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap">
                            <TextBlock.LayoutTransform>
                                <RotateTransform Angle="-90"/>
                            </TextBlock.LayoutTransform>
                        </TextBlock>
                    </ToggleButton>

                </StackPanel>
            </Border>

            <!-- Vertical divider between rail and content -->
            <Border Grid.Column="1"
                    Background="{StaticResource BorderBrush}"/>

            <!-- ── Content area (all three tab panels stacked, only one visible) ── -->
            <Grid Grid.Column="2">

                <!-- ── Tab: Widget Configuration ── -->
                <Grid x:Name="LeftPanelConfig" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Toolbar: expand/collapse-all + search -->
                    <Border Grid.Row="0"
                            Background="{StaticResource SidebarBgBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="10,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="ExpandCollapseAllBtn"
                                    Grid.Column="0"
                                    Style="{StaticResource ExpandCollapseAllBtn}"
                                    Content="▾"
                                    ToolTip="Collapse all"
                                    Click="ExpandCollapseAllBtn_Click"/>

                            <Grid Grid.Column="2">
                                <TextBox x:Name="ConfigSearchBox"
                                         Style="{StaticResource SearchFieldInput}"
                                         TextChanged="ConfigSearchBox_TextChanged"/>
                                <TextBlock Text="&#xE721;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="13"
                                           Foreground="{StaticResource TextDimBrush}"
                                           Margin="9,0,0,0"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"/>
                                <TextBlock x:Name="ConfigSearchPlaceholder"
                                           Text="Search…"
                                           Foreground="{StaticResource TextDimBrush}"
                                           FontFamily="Segoe UI"
                                           FontSize="12"
                                           Margin="29,0,0,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="0,8,0,8">
                        <StackPanel x:Name="GroupsPanel"/>
                    </ScrollViewer>

                    <Border Grid.Row="2"
                            Background="{StaticResource SidebarBgBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="20,12">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="UndoBtn"
                                    Style="{StaticResource UndoBtn}"
                                    IsEnabled="False"
                                    Click="Undo_Click">
                                Undo
                            </Button>

                            <Button x:Name="SaveBtn"
                                    Style="{StaticResource SaveBtn}"
                                    IsEnabled="False"
                                    Click="Save_Click">
                                Save
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ── Tab: Simulate Events ── -->
                <Grid x:Name="LeftPanelSimulate" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Padding="0,8,0,8">
                        <StackPanel>

                            <!-- ── Group: Chat ── -->
                            <StackPanel Margin="0,0,0,4">
                                <ToggleButton Style="{StaticResource GroupHeaderBtn}"
                                              IsChecked="False"
                                              x:Name="SimGroupChat">
                                    <TextBlock Text="CHAT"
                                               FontFamily="IBM Plex Mono, Consolas"
                                               FontSize="10"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </ToggleButton>
                                <StackPanel x:Name="SimGroupChatFields"
                                            Background="{StaticResource PanelBgBrush}"
                                            Margin="0,0,0,0">
                                    <Border BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="14,10">
                                        <Button Style="{StaticResource FieldButton}"
                                                HorizontalAlignment="Stretch"
                                                Click="SimulateChatMessage_Click">
                                            Chat Message
                                        </Button>
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <!-- ── Group: Follows ── -->
                            <StackPanel Margin="0,0,0,4">
                                <ToggleButton Style="{StaticResource GroupHeaderBtn}"
                                              IsChecked="False"
                                              x:Name="SimGroupFollows">
                                    <TextBlock Text="FOLLOWS"
                                               FontFamily="IBM Plex Mono, Consolas"
                                               FontSize="10"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </ToggleButton>
                                <StackPanel x:Name="SimGroupFollowsFields"
                                            Background="{StaticResource PanelBgBrush}">
                                    <Border BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="14,10">
                                        <Button Style="{StaticResource FieldButton}"
                                                HorizontalAlignment="Stretch"
                                                Click="SimulateFollow_Click">
                                            Follow
                                        </Button>
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <!-- ── Group: Subscriptions ── -->
                            <StackPanel Margin="0,0,0,4">
                                <ToggleButton Style="{StaticResource GroupHeaderBtn}"
                                              IsChecked="False"
                                              x:Name="SimGroupSubs">
                                    <TextBlock Text="SUBSCRIPTIONS"
                                               FontFamily="IBM Plex Mono, Consolas"
                                               FontSize="10"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </ToggleButton>
                                <StackPanel x:Name="SimGroupSubsFields"
                                            Background="{StaticResource PanelBgBrush}">
                                    <Border BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="14,10">
                                        <Button Style="{StaticResource FieldButton}"
                                                HorizontalAlignment="Stretch"
                                                Click="SimulateSub_Click">
                                            Sub
                                        </Button>
                                    </Border>
                                    <Border BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="14,10">
                                        <Button Style="{StaticResource FieldButton}"
                                                HorizontalAlignment="Stretch"
                                                Click="SimulateReSub_Click">
                                            ReSub
                                        </Button>
                                    </Border>
                                    <Border BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="14,10">
                                        <Button Style="{StaticResource FieldButton}"
                                                HorizontalAlignment="Stretch"
                                                Click="SimulateGiftedSub_Click">
                                            Gifted Sub
                                        </Button>
                                    </Border>
                                    <Border BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="14,10">
                                        <Button Style="{StaticResource FieldButton}"
                                                HorizontalAlignment="Stretch"
                                                Click="SimulateGiftedSubs_Click">
                                            Gifted Subs
                                        </Button>
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <!-- ── Group: Bits ── -->
                            <StackPanel Margin="0,0,0,4">
                                <ToggleButton Style="{StaticResource GroupHeaderBtn}"
                                              IsChecked="False"
                                              x:Name="SimGroupBits">
                                    <TextBlock Text="BITS"
                                               FontFamily="IBM Plex Mono, Consolas"
                                               FontSize="10"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </ToggleButton>
                                <StackPanel x:Name="SimGroupBitsFields"
                                            Background="{StaticResource PanelBgBrush}">
                                    <Border BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="14,10">
                                        <Button Style="{StaticResource FieldButton}"
                                                HorizontalAlignment="Stretch"
                                                Click="SimulateBits_Click">
                                            Bits
                                        </Button>
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <!-- ── Group: Raids ── -->
                            <StackPanel Margin="0,0,0,4">
                                <ToggleButton Style="{StaticResource GroupHeaderBtn}"
                                              IsChecked="False"
                                              x:Name="SimGroupRaids">
                                    <TextBlock Text="RAIDS"
                                               FontFamily="IBM Plex Mono, Consolas"
                                               FontSize="10"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </ToggleButton>
                                <StackPanel x:Name="SimGroupRaidsFields"
                                            Background="{StaticResource PanelBgBrush}">
                                    <Border BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="14,10">
                                        <Button Style="{StaticResource FieldButton}"
                                                HorizontalAlignment="Stretch"
                                                Click="SimulateRaid_Click">
                                            Raid
                                        </Button>
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ── Tab: Settings ── -->
                <Grid x:Name="LeftPanelSettings" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Padding="0,8,0,8">
                        <StackPanel>

                            <!-- ── Group: Canvas ── -->
                            <StackPanel Margin="0,0,0,4">
                                <ToggleButton Style="{StaticResource GroupHeaderBtn}"
                                              IsChecked="False"
                                              x:Name="SettingsGroupCanvas">
                                    <TextBlock Text="CANVAS"
                                               FontFamily="IBM Plex Mono, Consolas"
                                               FontSize="10"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </ToggleButton>
                                <StackPanel x:Name="SettingsGroupCanvasFields"
                                            Background="{StaticResource PanelBgBrush}">
                                    <!-- Canvas Size row — populated from code-behind -->
                                    <Border x:Name="SettingsCanvasSizeRow"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="14,10"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- ── Group: Widget ── -->
                            <StackPanel Margin="0,0,0,4">
                                <ToggleButton Style="{StaticResource GroupHeaderBtn}"
                                              IsChecked="False"
                                              x:Name="SettingsGroupWidget">
                                    <TextBlock Text="WIDGET"
                                               FontFamily="IBM Plex Mono, Consolas"
                                               FontSize="10"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </ToggleButton>
                                <StackPanel x:Name="SettingsGroupWidgetFields"
                                            Background="{StaticResource PanelBgBrush}">
                                    <!-- Width / Height / X / Y rows — populated from code-behind -->
                                    <Border x:Name="SettingsWidgetWidthRow"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="14,10"/>
                                    <Border x:Name="SettingsWidgetHeightRow"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="14,10"/>
                                    <Border x:Name="SettingsWidgetXRow"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="14,10"/>
                                    <Border x:Name="SettingsWidgetYRow"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="14,10"/>
                                </StackPanel>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>

            </Grid>
        </Grid>

        <!-- Drag splitter -->
        <GridSplitter Grid.Column="1"
                      Width="1"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="{StaticResource BorderBrush}"
                      ResizeBehavior="PreviousAndNext"
                      ResizeDirection="Columns"/>

        <!-- ═══════════════════════════════════════════════
             RIGHT PANEL — tab bar + content
             ═══════════════════════════════════════════════ -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <!-- Tab bar -->
                <RowDefinition Height="Auto"/>
                <!-- Tab content -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Tab bar -->
            <Border Grid.Row="0"
                    Background="{StaticResource SidebarBgBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <ToggleButton x:Name="TabPreview"
                                      Style="{StaticResource PreviewTabBtn}"
                                      IsChecked="True"
                                      Checked="TabPreview_Checked">
                            <TextBlock Text="Preview"
                                       FontFamily="Segoe UI"
                                       FontSize="12"/>
                        </ToggleButton>
                        <ToggleButton x:Name="TabLogs"
                                      Style="{StaticResource PreviewTabBtn}"
                                      IsChecked="False"
                                      Checked="TabLogs_Checked">
                            <TextBlock Text="Logs"
                                       FontFamily="Segoe UI"
                                       FontSize="12"/>
                        </ToggleButton>
                    </StackPanel>

                    <TextBlock x:Name="StatusText"
                               Grid.Column="1"
                               Foreground="{StaticResource TextDimBrush}"
                               FontFamily="Consolas"
                               FontSize="11"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0"
                               TextTrimming="CharacterEllipsis"
                               Text="Adjust settings then save."/>
                </Grid>
            </Border>

            <!-- Preview tab content -->
            <Grid x:Name="PreviewPanel" Grid.Row="1">
                <Grid.Background>
                    <DrawingBrush TileMode="Tile"
                                  Viewport="0,0,20,20"
                                  ViewportUnits="Absolute">
                        <DrawingBrush.Drawing>
                            <DrawingGroup>
                                <!-- White base -->
                                <GeometryDrawing Brush="#FFFFFF">
                                    <GeometryDrawing.Geometry>
                                        <RectangleGeometry Rect="0,0,20,20"/>
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                                <!-- Light grey squares (checkerboard) -->
                                <GeometryDrawing Brush="#E0E0E0">
                                    <GeometryDrawing.Geometry>
                                        <GeometryGroup>
                                            <RectangleGeometry Rect="0,0,10,10"/>
                                            <RectangleGeometry Rect="10,10,10,10"/>
                                        </GeometryGroup>
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                            </DrawingGroup>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Grid.Background>
                <Grid x:Name="PreviewCanvas"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
                    <Rectangle x:Name="PreviewCanvasBackground"/>
                    <wv2:WebView2CompositionControl x:Name="PreviewWebView"
                                                     Visibility="Hidden"/>
                </Grid>

                <!-- Shown while WebView2 is initialising -->
                <TextBlock x:Name="PreviewPlaceholder"
                           Text="Initialising preview…"
                           Foreground="{StaticResource TextDimBrush}"
                           FontFamily="Consolas"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- Logs tab content -->
            <Grid x:Name="LogsPanel" Grid.Row="1" Visibility="Collapsed">
                <ScrollViewer x:Name="LogsScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              Padding="12">
                    <TextBlock x:Name="LogsText"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontFamily="Consolas"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Text="No log entries yet."/>
                </ScrollViewer>
            </Grid>

        </Grid>
    </Grid>
</Window>
