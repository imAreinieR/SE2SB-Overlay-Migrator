<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ══════════════════════════════════════════════════════════════════════
         APP COLOR PALETTE
         Single source of truth for all colors used across the application.
         Merge this dictionary in App.xaml so every window and control
         can reference these keys without local redeclaration.
    ══════════════════════════════════════════════════════════════════════════ -->

    <!-- ── Backgrounds ──────────────────────────────────────────────────── -->
    <!-- Deepest background; main window root, footer bars -->
    <Color x:Key="AppBgColor">#0E1017</Color>
    <!-- Sidebar and secondary panel backgrounds -->
    <Color x:Key="SidebarBgColor">#0A0C14</Color>
    <!-- Right / detail panel background -->
    <Color x:Key="PanelBgColor">#13161F</Color>
    <!-- Primary raised surface (file list, path box, field inputs) -->
    <Color x:Key="SurfaceColor">#1A1E2B</Color>
    <!-- Secondary raised surface (buttons, list item selected, inline edit) -->
    <Color x:Key="SurfaceAltColor">#21263A</Color>
    <!-- Deepest control background (dropdown, field input) -->
    <Color x:Key="SurfaceDeepColor">#0F111A</Color>

    <!-- ── Borders ───────────────────────────────────────────────────────── -->
    <!-- Standard border used on panels, inputs, splitters -->
    <Color x:Key="BorderColor">#252C40</Color>
    <!-- Subtle border used on the new-widget button outline -->
    <Color x:Key="BorderAccentColor">#2A3560</Color>
    <!-- Drop zone dashed outline (idle) -->
    <Color x:Key="DropZoneBorderColor">#3D4A6E</Color>
    <!-- Hovered border (dropdown, toggle track) -->
    <Color x:Key="BorderHoverColor">#3A4060</Color>
    <!-- Toggle track checked border -->
    <Color x:Key="ToggleBorderCheckedColor">#3A4260</Color>
    <!-- Toggle checked background -->
    <Color x:Key="ToggleTrackCheckedColor">#1A3A52</Color>
    <!-- ComboBox item highlighted background -->
    <Color x:Key="ComboItemHighlightColor">#1E2538</Color>
    <!-- ComboBox item selected background -->
    <Color x:Key="ComboItemSelectedColor">#1A2A4A</Color>

    <!-- ── Accent ─────────────────────────────────────────────────────────── -->
    <!-- Primary blue accent: buttons, caret, focus rings, active indicators -->
    <Color x:Key="AccentBlueColor">#4F7EFF</Color>
    <!-- Lighter blue used for the slider thumb border -->
    <Color x:Key="AccentBlueLightColor">#7FA8FF</Color>
    <!-- Generate / save-success green -->
    <Color x:Key="AccentGreenColor">#3ECF8E</Color>
    <!-- Foreground on green accent backgrounds -->
    <Color x:Key="AccentGreenFgColor">#07200F</Color>

    <!-- ── Text ───────────────────────────────────────────────────────────── -->
    <!-- Primary readable text (widget names, file names, input values) -->
    <Color x:Key="TextPrimaryColor">#D0D6F0</Color>
    <!-- Secondary / label text (section headers, copy button icon) -->
    <Color x:Key="TextSecondaryColor">#7581A5</Color>
    <!-- Field label text -->
    <Color x:Key="TextFieldLabelColor">#8B94BD</Color>
    <!-- Muted text (drop zone icon) -->
    <Color x:Key="TextMutedColor">#4A5680</Color>
    <!-- Drop zone subtitle text -->
    <Color x:Key="TextSubtleColor">#4A5275</Color>
    <!-- Drop zone main label -->
    <Color x:Key="TextDropZoneColor">#7A86AA</Color>
    <!-- Dimmed status text (idle state) -->
    <Color x:Key="TextDimColor">#3A4060</Color>
    <!-- Hover foreground for tab buttons -->
    <Color x:Key="TextHoverColor">#A0AAD0</Color>

    <!-- ── Scrollbar ──────────────────────────────────────────────────────── -->
    <Color x:Key="ScrollThumbColor">#2E3650</Color>
    <!-- ScrollThumbHoverColor reuses DropZoneBorderColor (#3D4A6E) -->

    <!-- ── Semantic: Danger ───────────────────────────────────────────────── -->
    <!-- Error status text, unsupported-field label -->
    <Color x:Key="DangerColor">#FF6B6B</Color>
    <!-- Remove / delete X buttons -->
    <Color x:Key="DangerAltColor">#FF5F5F</Color>

    <!-- ── Semantic: Warning ──────────────────────────────────────────────── -->
    <Color x:Key="WarningBgColor">#221A0A</Color>
    <Color x:Key="WarningBorderColor">#7A4A10</Color>
    <Color x:Key="WarningIconColor">#F0A04B</Color>
    <Color x:Key="WarningTextColor">#E8B87A</Color>


    <!-- ══════════════════════════════════════════════════════════════════════
         SOLID COLOR BRUSHES
         Derived from the Color entries above. Reference these in XAML
         style Setters, TemplateBindings, and inline attributes.
    ══════════════════════════════════════════════════════════════════════════ -->

    <SolidColorBrush x:Key="AppBgBrush"              Color="{StaticResource AppBgColor}"/>
    <SolidColorBrush x:Key="SidebarBgBrush"          Color="{StaticResource SidebarBgColor}"/>
    <SolidColorBrush x:Key="PanelBgBrush"            Color="{StaticResource PanelBgColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush"            Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceAltBrush"         Color="{StaticResource SurfaceAltColor}"/>
    <SolidColorBrush x:Key="SurfaceDeepBrush"        Color="{StaticResource SurfaceDeepColor}"/>

    <SolidColorBrush x:Key="BorderBrush"             Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderAccentBrush"       Color="{StaticResource BorderAccentColor}"/>
    <SolidColorBrush x:Key="DropZoneBorderBrush"     Color="{StaticResource DropZoneBorderColor}"/>
    <SolidColorBrush x:Key="BorderHoverBrush"        Color="{StaticResource BorderHoverColor}"/>

    <SolidColorBrush x:Key="AccentBlueBrush"         Color="{StaticResource AccentBlueColor}"/>
    <SolidColorBrush x:Key="AccentBlueLightBrush"    Color="{StaticResource AccentBlueLightColor}"/>
    <SolidColorBrush x:Key="AccentGreenBrush"        Color="{StaticResource AccentGreenColor}"/>
    <SolidColorBrush x:Key="AccentGreenFgBrush"      Color="{StaticResource AccentGreenFgColor}"/>

    <SolidColorBrush x:Key="ComboItemHighlightBrush"  Color="{StaticResource ComboItemHighlightColor}"/>
    <SolidColorBrush x:Key="ComboItemSelectedBrush"   Color="{StaticResource ComboItemSelectedColor}"/>
    <SolidColorBrush x:Key="ToggleBorderCheckedBrush" Color="{StaticResource ToggleBorderCheckedColor}"/>
    <SolidColorBrush x:Key="ToggleTrackCheckedBrush"  Color="{StaticResource ToggleTrackCheckedColor}"/>

    <SolidColorBrush x:Key="TextPrimaryBrush"        Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush"      Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextFieldLabelBrush"     Color="{StaticResource TextFieldLabelColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush"          Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="TextSubtleBrush"         Color="{StaticResource TextSubtleColor}"/>
    <SolidColorBrush x:Key="TextDropZoneBrush"       Color="{StaticResource TextDropZoneColor}"/>
    <SolidColorBrush x:Key="TextDimBrush"            Color="{StaticResource TextDimColor}"/>
    <SolidColorBrush x:Key="TextHoverBrush"          Color="{StaticResource TextHoverColor}"/>

    <SolidColorBrush x:Key="ScrollThumbBrush"        Color="{StaticResource ScrollThumbColor}"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush"   Color="{StaticResource DropZoneBorderColor}"/>

    <SolidColorBrush x:Key="DangerBrush"             Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="DangerAltBrush"          Color="{StaticResource DangerAltColor}"/>

    <SolidColorBrush x:Key="WarningBgBrush"          Color="{StaticResource WarningBgColor}"/>
    <SolidColorBrush x:Key="WarningBorderBrush"      Color="{StaticResource WarningBorderColor}"/>
    <SolidColorBrush x:Key="WarningIconBrush"        Color="{StaticResource WarningIconColor}"/>
    <SolidColorBrush x:Key="WarningTextBrush"        Color="{StaticResource WarningTextColor}"/>

</ResourceDictionary>
