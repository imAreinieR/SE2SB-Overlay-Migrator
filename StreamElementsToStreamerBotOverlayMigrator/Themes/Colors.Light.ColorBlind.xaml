<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ══════════════════════════════════════════════════════════════════════
         APP COLOR PALETTE — LIGHT, COLOR-BLIND SAFE
         Identical to Colors.Light.xaml except for the Danger / Warning / Success
         triad — see Colors.Dark.ColorBlind.xaml for the rationale.
    ══════════════════════════════════════════════════════════════════════════ -->

    <!-- ── Backgrounds ──────────────────────────────────────────────────── -->
    <Color x:Key="AppBgColor">#F0F2F8</Color>
    <Color x:Key="SidebarBgColor">#E6E9F2</Color>
    <Color x:Key="PanelBgColor">#F5F6FA</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceAltColor">#EDF0F7</Color>
    <Color x:Key="SurfaceDeepColor">#FFFFFF</Color>

    <!-- ── Borders ───────────────────────────────────────────────────────── -->
    <Color x:Key="BorderColor">#D0D5E8</Color>
    <Color x:Key="BorderAccentColor">#A8B4D8</Color>
    <Color x:Key="DropZoneBorderColor">#9AAAD0</Color>
    <Color x:Key="BorderHoverColor">#A0AACC</Color>
    <Color x:Key="ToggleBorderCheckedColor">#A0B0D0</Color>
    <Color x:Key="ToggleTrackCheckedColor">#C8DCEF</Color>
    <Color x:Key="ComboItemHighlightColor">#E8EBF5</Color>
    <Color x:Key="ComboItemSelectedColor">#D4DCEF</Color>

    <!-- ── Accent ─────────────────────────────────────────────────────────── -->
    <!-- Primary blue accent: buttons, caret, focus rings, active indicators (unchanged) -->
    <Color x:Key="AccentBlueColor">#3D6FFF</Color>
    <Color x:Key="AccentBlueLightColor">#6D96FF</Color>
    <!-- Generate / save-success — deep teal instead of green so it can't be misread as "danger".
         Verified against #D6336C Danger via simulated protanopia/deuteranopia (CIEDE ΔE > 18
         in the weakest case) and against white foreground text (11.7:1 contrast, WCAG AA). -->
    <Color x:Key="AccentGreenColor">#0C3C55</Color>
    <!-- Foreground on success accent backgrounds -->
    <Color x:Key="AccentGreenFgColor">#FFFFFF</Color>

    <!-- ── Text ───────────────────────────────────────────────────────────── -->
    <Color x:Key="TextPrimaryColor">#1A1E30</Color>
    <Color x:Key="TextSecondaryColor">#5A6280</Color>
    <Color x:Key="TextFieldLabelColor">#4A5480</Color>
    <Color x:Key="TextMutedColor">#8890B0</Color>
    <Color x:Key="TextSubtleColor">#9098B8</Color>
    <Color x:Key="TextDropZoneColor">#6A74A0</Color>
    <Color x:Key="TextDimColor">#9AA0BC</Color>
    <Color x:Key="TextHoverColor">#2A3060</Color>

    <!-- ── Scrollbar ──────────────────────────────────────────────────────── -->
    <Color x:Key="ScrollThumbColor">#C0C8DC</Color>
    <!-- ScrollThumbHoverColor reuses DropZoneBorderColor (#9AAAD0) -->

    <!-- ── Semantic: Danger ───────────────────────────────────────────────── -->
    <!-- Error status text, unsupported-field label — rose/magenta instead of pure red -->
    <Color x:Key="DangerColor">#D6336C</Color>
    <!-- Remove / delete X buttons -->
    <Color x:Key="DangerAltColor">#C2255C</Color>

    <!-- ── Semantic: Warning ──────────────────────────────────────────────── -->
    <!-- Shifted from orange toward pure gold to maximize hue distance from Danger -->
    <Color x:Key="WarningBgColor">#FFFBEA</Color>
    <Color x:Key="WarningBorderColor">#E8C43C</Color>
    <Color x:Key="WarningIconColor">#B08A00</Color>
    <Color x:Key="WarningTextColor">#6B5000</Color>


    <!-- ══════════════════════════════════════════════════════════════════════
         SOLID COLOR BRUSHES
         Identical keys to Colors.Light.xaml — only values differ.
    ══════════════════════════════════════════════════════════════════════════ -->

    <SolidColorBrush x:Key="AppBgBrush"              Color="{StaticResource AppBgColor}"/>
    <SolidColorBrush x:Key="SidebarBgBrush"          Color="{StaticResource SidebarBgColor}"/>
    <SolidColorBrush x:Key="PanelBgBrush"            Color="{StaticResource PanelBgColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush"            Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceAltBrush"         Color="{StaticResource SurfaceAltColor}"/>
    <SolidColorBrush x:Key="SurfaceDeepBrush"        Color="{StaticResource SurfaceDeepColor}"/>

    <SolidColorBrush x:Key="BorderBrush"             Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderAccentBrush"       Color="{StaticResource BorderAccentColor}"/>
    <SolidColorBrush x:Key="DropZoneBorderBrush"     Color="{StaticResource DropZoneBorderColor}"/>
    <SolidColorBrush x:Key="BorderHoverBrush"        Color="{StaticResource BorderHoverColor}"/>

    <SolidColorBrush x:Key="AccentBlueBrush"         Color="{StaticResource AccentBlueColor}"/>
    <SolidColorBrush x:Key="AccentBlueLightBrush"    Color="{StaticResource AccentBlueLightColor}"/>
    <SolidColorBrush x:Key="AccentGreenBrush"        Color="{StaticResource AccentGreenColor}"/>
    <SolidColorBrush x:Key="AccentGreenFgBrush"      Color="{StaticResource AccentGreenFgColor}"/>

    <SolidColorBrush x:Key="ComboItemHighlightBrush"  Color="{StaticResource ComboItemHighlightColor}"/>
    <SolidColorBrush x:Key="ComboItemSelectedBrush"   Color="{StaticResource ComboItemSelectedColor}"/>
    <SolidColorBrush x:Key="ToggleBorderCheckedBrush" Color="{StaticResource ToggleBorderCheckedColor}"/>
    <SolidColorBrush x:Key="ToggleTrackCheckedBrush"  Color="{StaticResource ToggleTrackCheckedColor}"/>

    <SolidColorBrush x:Key="TextPrimaryBrush"        Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush"      Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextFieldLabelBrush"     Color="{StaticResource TextFieldLabelColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush"          Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="TextSubtleBrush"         Color="{StaticResource TextSubtleColor}"/>
    <SolidColorBrush x:Key="TextDropZoneBrush"       Color="{StaticResource TextDropZoneColor}"/>
    <SolidColorBrush x:Key="TextDimBrush"            Color="{StaticResource TextDimColor}"/>
    <SolidColorBrush x:Key="TextHoverBrush"          Color="{StaticResource TextHoverColor}"/>

    <SolidColorBrush x:Key="ScrollThumbBrush"        Color="{StaticResource ScrollThumbColor}"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush"   Color="{StaticResource DropZoneBorderColor}"/>

    <SolidColorBrush x:Key="DangerBrush"             Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="DangerAltBrush"          Color="{StaticResource DangerAltColor}"/>

    <SolidColorBrush x:Key="WarningBgBrush"          Color="{StaticResource WarningBgColor}"/>
    <SolidColorBrush x:Key="WarningBorderBrush"      Color="{StaticResource WarningBorderColor}"/>
    <SolidColorBrush x:Key="WarningIconBrush"        Color="{StaticResource WarningIconColor}"/>
    <SolidColorBrush x:Key="WarningTextBrush"        Color="{StaticResource WarningTextColor}"/>

</ResourceDictionary>
