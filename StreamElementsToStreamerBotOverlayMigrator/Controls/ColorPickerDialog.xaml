<Window x:Class="StreamElementsToStreamerBotOverlayMigrator.Controls.ColorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pick a Colour"
        Width="320" Height="460"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBgBrush}"
        ShowInTaskbar="False">

    <Window.Resources>

        <Style x:Key="SliderTrack" TargetType="Slider">
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border x:Name="TrackBorder"
                                    Height="14"
                                    VerticalAlignment="Center"
                                    CornerRadius="7"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    Background="{TemplateBinding Background}"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Opacity="0" IsHitTestVisible="True"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="18" Height="18"
                                                         Fill="White"
                                                         Stroke="{StaticResource BorderBrush}"
                                                         StrokeThickness="1.5"
                                                         Effect="{x:Null}"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Opacity="0" IsHitTestVisible="True"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HexInput" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource SurfaceDeepBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBlueBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="8,0"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChannelInput" TargetType="TextBox" BasedOn="{StaticResource HexInput}">
            <Setter Property="Width" Value="48"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <Style x:Key="ConfirmBtn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentGreenBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentGreenFgBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CancelBtn" TargetType="Button" BasedOn="{StaticResource ConfirmBtn}">
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>

    </Window.Resources>

    <StackPanel Margin="14">

        <!-- SV square picker -->
        <Border CornerRadius="6" ClipToBounds="True"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                Margin="0,0,0,8">
            <Grid Width="280" Height="160">
                <!-- White-to-transparent (left→right) over hue background -->
                <Border x:Name="HueSurface" CornerRadius="5"/>
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="White" Offset="0"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <!-- Transparent-to-black (top→bottom) -->
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="Transparent" Offset="0"/>
                            <GradientStop Color="Black" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <!-- Draggable crosshair cursor -->
                <Canvas x:Name="SvCanvas" MouseDown="SvCanvas_MouseDown" MouseUp="SvCanvas_MouseUp" MouseMove="SvCanvas_MouseMove"
                        Background="Transparent">
                    <Ellipse x:Name="SvCursor"
                             Width="14" Height="14"
                             Stroke="White" StrokeThickness="2"
                             Fill="Transparent"
                             Canvas.Left="0" Canvas.Top="0"
                             IsHitTestVisible="False"/>
                </Canvas>
            </Grid>
        </Border>

        <!-- Hue slider -->
        <TextBlock Text="HUE" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="IBM Plex Mono, Consolas"
                   FontSize="9" Margin="0,0,0,3"/>
        <Slider x:Name="HueSlider"
                IsMoveToPointEnabled="True"
                Style="{StaticResource SliderTrack}"
                Minimum="0" Maximum="360"
                ValueChanged="HueSlider_ValueChanged"
                Margin="0,0,0,8">
            <Slider.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#FF0000" Offset="0"/>
                    <GradientStop Color="#FFFF00" Offset="0.167"/>
                    <GradientStop Color="#00FF00" Offset="0.333"/>
                    <GradientStop Color="#00FFFF" Offset="0.5"/>
                    <GradientStop Color="#0000FF" Offset="0.667"/>
                    <GradientStop Color="#FF00FF" Offset="0.833"/>
                    <GradientStop Color="#FF0000" Offset="1"/>
                </LinearGradientBrush>
            </Slider.Background>
        </Slider>

        <!-- Alpha slider -->
        <TextBlock Text="ALPHA" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="IBM Plex Mono, Consolas"
                   FontSize="9" Margin="0,0,0,4"/>
        <Slider x:Name="AlphaSlider"
                IsMoveToPointEnabled="True"
                Style="{StaticResource SliderTrack}"
                Minimum="0" Maximum="255"
                Value="255"
                ValueChanged="AlphaSlider_ValueChanged"
                Margin="0,0,0,10"/>

        <!-- Preview + hex/rgba inputs -->
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Swatch preview (checkerboard for alpha, colour on top) -->
            <Border Grid.Column="0" CornerRadius="4"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    ClipToBounds="True" Height="48">
                <Grid>
                    <Border x:Name="CheckerBoard">
                        <Border.Background>
                            <DrawingBrush TileMode="Tile" Viewport="0,0,8,8" ViewportUnits="Absolute">
                                <DrawingBrush.Drawing>
                                    <DrawingGroup>
                                        <GeometryDrawing Brush="#555" Geometry="M0,0 H8 V8 H0 Z"/>
                                        <GeometryDrawing Brush="#888" Geometry="M0,0 H4 V4 H0 Z M4,4 H8 V8 H4 Z"/>
                                    </DrawingGroup>
                                </DrawingBrush.Drawing>
                            </DrawingBrush>
                        </Border.Background>
                    </Border>
                    <Border x:Name="PreviewSwatch" CornerRadius="3"/>
                </Grid>
            </Border>

            <!-- Hex + RGBA fields -->
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBox x:Name="HexBox"
                         Style="{StaticResource HexInput}"
                         TextChanged="HexBox_TextChanged"
                         MaxLength="9"
                         ToolTip="#RRGGBB or #AARRGGBB"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <StackPanel Margin="0,0,4,0">
                        <TextBox x:Name="RBox" Style="{StaticResource ChannelInput}" TextChanged="RgbaBox_TextChanged" MaxLength="3"/>
                        <TextBlock Text="R" Foreground="{StaticResource TextSecondaryBrush}" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,4,0">
                        <TextBox x:Name="GBox" Style="{StaticResource ChannelInput}" TextChanged="RgbaBox_TextChanged" MaxLength="3"/>
                        <TextBlock Text="G" Foreground="{StaticResource TextSecondaryBrush}" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,4,0">
                        <TextBox x:Name="BBox" Style="{StaticResource ChannelInput}" TextChanged="RgbaBox_TextChanged" MaxLength="3"/>
                        <TextBlock Text="B" Foreground="{StaticResource TextSecondaryBrush}" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBox x:Name="ABox" Style="{StaticResource ChannelInput}" TextChanged="RgbaBox_TextChanged" MaxLength="3"/>
                        <TextBlock Text="A" Foreground="{StaticResource TextSecondaryBrush}" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Confirm / Cancel -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Style="{StaticResource CancelBtn}"
                    Content="Cancel" Click="Cancel_Click"/>
            <Button Grid.Column="2" Style="{StaticResource ConfirmBtn}"
                    Content="Apply" Click="Apply_Click"/>
        </Grid>

    </StackPanel>
</Window>
