<Window x:Class="StreamElementsToStreamerBotMigrationTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SE Overlay Migration Tool"
        Width="780" Height="520"
        MinWidth="680" MinHeight="460"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#0e1017">

    <Window.Resources>

        <!-- ── Button base ── -->
        <Style x:Key="BaseBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.65"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SaveBtn" TargetType="Button" BasedOn="{StaticResource BaseBtn}">
            <Setter Property="Background" Value="#4f7eff"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="14,6"/>
        </Style>

        <Style x:Key="ImportBtn" TargetType="Button" BasedOn="{StaticResource BaseBtn}">
            <Setter Property="Background" Value="#21263a"/>
            <Setter Property="Foreground" Value="#d0d6f0"/>
            <Setter Property="BorderBrush" Value="#252c40"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,6"/>
        </Style>

        <Style x:Key="SmallImportBtn" TargetType="Button" BasedOn="{StaticResource BaseBtn}">
            <Setter Property="Background" Value="#21263a"/>
            <Setter Property="Foreground" Value="#d0d6f0"/>
            <Setter Property="BorderBrush" Value="#252c40"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style x:Key="SaveChangesBtn" TargetType="Button" BasedOn="{StaticResource BaseBtn}">
            <Setter Property="Background" Value="#21263a"/>
            <Setter Property="Foreground" Value="#d0d6f0"/>
            <Setter Property="BorderBrush" Value="#252c40"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,0"/>
        </Style>

        <Style x:Key="GenerateBtn" TargetType="Button" BasedOn="{StaticResource BaseBtn}">
            <Setter Property="Background" Value="#3ecf8e"/>
            <Setter Property="Foreground" Value="#07200f"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="22,9"/>
        </Style>

        <Style x:Key="CopyBtn" TargetType="Button" BasedOn="{StaticResource BaseBtn}">
            <Setter Property="Background" Value="#21263a"/>
            <Setter Property="Foreground" Value="#5a6280"/>
            <Setter Property="BorderBrush" Value="#252c40"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="NewWidgetBtn" TargetType="Button" BasedOn="{StaticResource BaseBtn}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#4f7eff"/>
            <Setter Property="BorderBrush" Value="#2a3560"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0,7"/>
        </Style>

        <!-- Remove X button — transparent, shown via trigger on parent -->
        <Style x:Key="RemoveWidgetBtn" TargetType="Button" BasedOn="{StaticResource BaseBtn}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#ff5f5f"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- File remove X -->
        <Style x:Key="FileRemoveBtn" TargetType="Button" BasedOn="{StaticResource BaseBtn}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#ff5f5f"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- Read-only path TextBox -->
        <Style x:Key="PathBox" TargetType="TextBox">
            <Setter Property="Background" Value="#1a1e2b"/>
            <Setter Property="Foreground" Value="#5a6280"/>
            <Setter Property="BorderBrush" Value="#252c40"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="10,0"
                                          VerticalAlignment="Center"
                                          VerticalScrollBarVisibility="Hidden"
                                          HorizontalScrollBarVisibility="Hidden"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Editable name TextBox -->
        <Style x:Key="NameBox" TargetType="TextBox">
            <Setter Property="Background" Value="#1a1e2b"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="#4f7eff"/>
            <Setter Property="BorderBrush" Value="#252c40"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="10,0"
                                          VerticalAlignment="Center"
                                          VerticalScrollBarVisibility="Hidden"
                                          HorizontalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#4f7eff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Section label -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#5a6280"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

    </Window.Resources>

    <!-- ══════════════════════════════════════════
         Two-panel layout: sidebar | detail
    ═══════════════════════════════════════════════ -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── LEFT SIDEBAR ── -->
        <Border Grid.Column="0"
                Background="#0a0c14"
                BorderBrush="#252c40"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Header -->
                    <RowDefinition Height="*"/>     <!-- Widget list -->
                </Grid.RowDefinitions>

                <!-- Sidebar header -->
                <Border Grid.Row="0"
                        BorderBrush="#252c40"
                        BorderThickness="0,0,0,1"
                        Padding="14,14,14,12">
                    <StackPanel>
                        <TextBlock Text="WIDGETS"
                                   Style="{StaticResource SectionLabel}"
                                   Margin="0,0,0,10"/>
                        <Button Style="{StaticResource NewWidgetBtn}"
                                Click="NewWidget_Click">
                            <TextBlock Text="＋  New Widget"
                                       FontFamily="Segoe UI"
                                       FontSize="12"/>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Widget list -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              Padding="8,8">
                    <ItemsControl x:Name="WidgetList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid x:Name="WidgetRow" Margin="0,2">

                                    <!-- Hover trigger to show X -->
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>

                                    <Border x:Name="ItemBorder"
                                            CornerRadius="5"
                                            Padding="10,9"
                                            BorderThickness="1"
                                            BorderBrush="Transparent"
                                            Background="Transparent"
                                            Cursor="Hand">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>  <!-- Status dot -->
                                                <ColumnDefinition Width="*"/>     <!-- Name -->
                                                <ColumnDefinition Width="Auto"/>  <!-- X -->
                                            </Grid.ColumnDefinitions>

                                            <!-- Status dot -->
                                            <Ellipse Grid.Column="0"
                                                     Width="6" Height="6"
                                                     Margin="0,0,8,0"
                                                     VerticalAlignment="Center"
                                                     Fill="{Binding StatusColor}"/>

                                            <!-- Widget name + edit icon -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}"
                                                           FontFamily="Segoe UI"
                                                           FontSize="12"
                                                           Foreground="#d0d6f0"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxWidth="110"/>
                                                <TextBlock x:Name="EditIcon"
                                                           Text=" ✎"
                                                           FontSize="11"
                                                           Foreground="#5a6280"
                                                           VerticalAlignment="Center"
                                                           Opacity="0"
                                                           Cursor="Hand"
                                                           MouseLeftButtonUp="EditWidgetName_Click"/>
                                            </StackPanel>

                                            <!-- Remove X (hidden, shown on row hover) -->
                                            <Button Grid.Column="2"
                                                    x:Name="RemoveBtn"
                                                    Content="✕"
                                                    Tag="{Binding}"
                                                    Style="{StaticResource RemoveWidgetBtn}"
                                                    Click="RemoveWidget_Click"/>
                                        </Grid>
                                    </Border>

                                    <!-- Hover/active triggers -->
                                    <Grid.Triggers>
                                        <EventTrigger RoutedEvent="MouseEnter">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="RemoveBtn"
                                                                     Storyboard.TargetProperty="Opacity"
                                                                     To="0.6" Duration="0:0:0.15"/>
                                                    <DoubleAnimation Storyboard.TargetName="EditIcon"
                                                                     Storyboard.TargetProperty="Opacity"
                                                                     To="0.6" Duration="0:0:0.15"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                        <EventTrigger RoutedEvent="MouseLeave">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="RemoveBtn"
                                                                     Storyboard.TargetProperty="Opacity"
                                                                     To="0" Duration="0:0:0.15"/>
                                                    <DoubleAnimation Storyboard.TargetName="EditIcon"
                                                                     Storyboard.TargetProperty="Opacity"
                                                                     To="0" Duration="0:0:0.15"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Grid.Triggers>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

            </Grid>
        </Border>

        <!-- ── RIGHT DETAIL PANEL ── -->
        <Grid Grid.Column="1" Background="#13161f">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>     <!-- Detail content / empty state -->
                <RowDefinition Height="Auto"/>  <!-- Detail footer -->
            </Grid.RowDefinitions>

            <!-- Empty state (shown when no widget selected) -->
            <Grid Grid.Row="0" x:Name="EmptyStatePanel" Visibility="Visible">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="📦"
                               FontSize="36"
                               HorizontalAlignment="Center"
                               Opacity="0.2"
                               Margin="0,0,0,12"/>
                    <TextBlock Text="No widgets yet."
                               Foreground="#3a4060"
                               FontFamily="Segoe UI"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,14"/>
                    <Button Style="{StaticResource NewWidgetBtn}"
                            Padding="20,10"
                            Click="NewWidget_Click">
                        <TextBlock Text="＋  Create a widget to get started"
                                   FontFamily="Segoe UI"
                                   FontSize="13"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Detail content (shown when widget selected) -->
            <ScrollViewer Grid.Row="0" x:Name="DetailPanel" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto"
                          Padding="20,16">
                <StackPanel>

                    <!-- Warning banner -->
                    <Border x:Name="WarningBanner"
                            Background="#221a0a"
                            BorderBrush="#7a4a10"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="12,8"
                            Margin="0,0,0,14"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠  "
                                       Foreground="#f0a04b"
                                       FontSize="12"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="WarningText"
                                       Foreground="#e8b87a"
                                       FontFamily="Segoe UI"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Files section -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="FILES" Style="{StaticResource SectionLabel}" Margin="0" VerticalAlignment="Center"/>
                        <Button Grid.Column="1"
                                Style="{StaticResource SmallImportBtn}"
                                Height="22"
                                Click="Import_Click">
                            ＋ Import
                        </Button>
                    </Grid>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- File list -->
                        <Border Grid.Column="0"
                                Background="#1a1e2b"
                                BorderBrush="#252c40"
                                BorderThickness="1"
                                CornerRadius="5"
                                MinHeight="40">
                            <StackPanel>
                                <ItemsControl x:Name="FileList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Border BorderBrush="#252c40"
                                                        BorderThickness="0,0,0,1"
                                                        Padding="10,7">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Extension badge -->
                                                        <Border Grid.Column="0"
                                                                Background="{Binding ExtBackground}"
                                                                CornerRadius="3"
                                                                Padding="5,2"
                                                                Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding Extension}"
                                                                       Foreground="{Binding ExtColor}"
                                                                       FontFamily="Consolas"
                                                                       FontSize="10"/>
                                                        </Border>

                                                        <!-- Filename -->
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding FileName}"
                                                                   Foreground="#d0d6f0"
                                                                   FontFamily="Consolas"
                                                                   FontSize="11"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"/>

                                                        <!-- Remove X (hidden until row hover) -->
                                                        <Button Grid.Column="2"
                                                                x:Name="FileRemoveBtn"
                                                                Content="✕"
                                                                Tag="{Binding}"
                                                                Style="{StaticResource FileRemoveBtn}"
                                                                Click="RemoveFile_Click"/>
                                                    </Grid>
                                                </Border>

                                                <!-- Hover triggers for X fade -->
                                                <Grid.Triggers>
                                                    <EventTrigger RoutedEvent="MouseEnter">
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="FileRemoveBtn"
                                                                                 Storyboard.TargetProperty="Opacity"
                                                                                 To="0.6" Duration="0:0:0.15"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                    <EventTrigger RoutedEvent="MouseLeave">
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="FileRemoveBtn"
                                                                                 Storyboard.TargetProperty="Opacity"
                                                                                 To="0" Duration="0:0:0.15"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </Grid.Triggers>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Empty state -->
                                <TextBlock x:Name="FilesEmptyLabel"
                                           Text="No files imported."
                                           Foreground="#2e3450"
                                           FontFamily="Segoe UI"
                                           FontSize="12"
                                           HorizontalAlignment="Center"
                                           Margin="0,14"/>
                            </StackPanel>
                        </Border>

                    </Grid>

                    <!-- Deploy path section -->
                    <TextBlock Text="DEPLOY LOCATION" Style="{StaticResource SectionLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 x:Name="DeployPathBox"
                                 Style="{StaticResource PathBox}"
                                 Height="34"/>

                        <Button Grid.Column="2"
                                Style="{StaticResource CopyBtn}"
                                Height="34"
                                ToolTip="Copy path to clipboard"
                                Click="CopyPath_Click">
                            <TextBlock Text="⧉" FontSize="14" Foreground="#5a6280"/>
                        </Button>
                    </Grid>

                </StackPanel>
            </ScrollViewer>

            <!-- Detail footer: status + generate -->
            <Border Grid.Row="1"
                    Background="#0e1017"
                    BorderBrush="#252c40"
                    BorderThickness="0,1,0,0"
                    Padding="20,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="StatusText"
                               Grid.Column="0"
                               Foreground="#3a4060"
                               FontFamily="Consolas"
                               FontSize="11"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Text="Select or create a widget to begin."/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="SaveChangesBtn"
                                Style="{StaticResource SaveChangesBtn}"
                                Height="38"
                                Margin="0,0,8,0"
                                IsEnabled="False"
                                Click="SaveWidget_Click">
                            Save Changes
                        </Button>
                        <Button x:Name="GenerateBtn"
                                Style="{StaticResource GenerateBtn}"
                                Height="38"
                                IsEnabled="False"
                                Click="Generate_Click">
                            Generate
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</Window>

